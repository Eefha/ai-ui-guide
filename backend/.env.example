# ============ 大模型（阿里云百炼 / DashScope） ============
# 必填
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 主模型：视觉理解 + JSON 输出。换模型时注意它是否支持图片输入
# qwen3-vl-plus 实测比 qwen3.8-omni-flash 快一个数量级（5~8s vs 27~83s），定位同样准
QWEN_MODEL=qwen3-vl-plus
# 建索引时给知识库里的图片写描述用的模型
QWEN_VLM_MODEL=qwen3-vl-plus

# ============ 阿里云 OCR ============
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ENABLE_OCR=true

# ============ 联网搜索（百度千帆，可留空关闭） ============
BAIDU_SEARCH_API_KEY=
ENABLE_WEB_SEARCH=true
# 带截图时是否也联网。默认 false：用户问"这张图上点哪"，网上搜不到答案，只会更慢
WEB_SEARCH_WITH_IMAGE=false

# ============ 检索参数 ============
ENABLE_RAG=true
RAG_TOP_K=3
RAG_MIN_SCORE=0.65
WEB_MIN_SCORE=0.55
WEB_TOP_K=6

# ============ 会话 ============
JWT_SECRET=please-change-this
JWT_EXPIRE_DAYS=7

# ============ 邮件验证码 ============
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASSWORD=授权码（不是登录密码）
SMTP_FROM_NAME=AI 软件操作引导

# ============ 可选微调 ============
# IMAGE_MAX_SIDE=1600        # 送模型前把长边压到多少像素，调小更快、调大更准
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1
# MIN_BBOX_SIDE=0.028        # 坐标框最小边长（占整图比例）
# MAX_BBOX_AREA=0.45         # 坐标框面积上限，超过视为框住了整块面板
# MAX_HISTORY_STEPS=5
